  "formulas": [
    {
      "id": "physical_damage_received",
      "name": "받는 물리 피해",
      "expression": "max(1,(incoming_damage-defense)*(1-physical_resist_pct)*(1+received_physical_damage_delta_pct))",
      "module_id": "combat_core"
    },
    {
      "id": "magic_damage_received",
      "name": "받는 마법 피해",
      "expression": "max(1,incoming_damage*(1-magic_resist_pct)*(1+received_magic_damage_delta_pct))",
      "module_id": "combat_core"
    },
    {
      "id": "outgoing_damage",
      "name": "주는 피해",
      "expression": "random(min_attack,max_attack)*(1+damage_increase_pct)*skill_multiplier",
      "module_id": "combat_core"
    },
    {
      "id": "critical_damage",
      "name": "크리티컬 피해",
      "expression": "outgoing_damage*(1+critical_multiplier_pct)",
      "module_id": "combat_core"
    },
    {
      "id": "hp_regen_tick",
      "name": "체력 리젠",
      "expression": "max_hp*hp_regen_per_10s_pct*(tick_interval_ms/10000)",
      "module_id": "combat_core"
    },
    {
      "id": "enhance_success_rate",
      "name": "강화 성공률",
      "expression": "clamp(base_rate + enhance_success_bonus_pct - enhance_level*penalty_per_level, min_rate, max_rate)",
      "module_id": "enhance_system"
    },
    {
      "id": "drop_chance_final",
      "name": "최종 드랍률",
      "expression": "clamp(base_drop_chance_pct*(1+item_find_chance_pct),0,max_drop_chance_pct)",
      "module_id": "loot_system"
    }
  ]
}